def partir(
    texto,
    limite
):

    texto = texto.strip()

    if len(texto) <= limite:

        return [
            texto
        ] if texto else [
            "😊"
        ]

    pedazos = []

    actual = ""

    for linea in texto.split(
        "\n"
    ):

        if (
            len(actual)
            + len(linea)
            + 1
            > limite
        ):

            pedazos.append(
                actual.strip()
            )

            actual = ""

        actual += (
            linea
            + "\n"
        )

    if actual.strip():

        pedazos.append(
            actual.strip()
        )

    return pedazos


