def preguntar_a_gemini(
    historial,
    texto_nuevo,
    prompt=SYSTEM_PROMPT
):

    url = (
        "https://generativelanguage.googleapis.com/v1beta/"
        "models/gemini-flash-latest:"
        f"generateContent?key={GEMINI_KEY}"
    )

    contenidos = []

    for m in historial:

        contenidos.append({
            "role": m["rol"],
            "parts": [
                {
                    "text": m["mensaje"]
                }
            ]
        })

    contenidos.append({
        "role": "user",
        "parts": [
            {
                "text": texto_nuevo
            }
        ]
    })

    cuerpo = {

        "system_instruction": {
            "parts": [
                {
                    "text": prompt
                }
            ]
        },

        "contents": contenidos
    }

    r = requests.post(
        url,
        json=cuerpo,
        timeout=30
    )

    if r.status_code != 200:

        print(
            ">>> GEMINI error:",
            r.status_code,
            r.text
        )

        return (
            "Hola! Gracias por escribir "
            "a Guaranistore. "
            "Ya te atiendo 😊"
        )

    data = r.json()

    try:

        return (
            data["candidates"][0]
